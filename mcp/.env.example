# 複製為 .env 並填入實際值（.env 已列入 .gitignore，請勿提交）
# 注意：docker env_file 不會去除引號，值請不要加引號，也勿含換行。

# ---- MCP Toolbox ----
TOOLBOX_VERSION=1.15.0
# 監聽所有 IP，安全性由外部 Nginx 白名單控制
TOOLBOX_ADDRESS=0.0.0.0
TOOLBOX_PORT=19500

# ---- MySQL（唯讀帳號）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=company
MYSQL_USER=mcp_user
MYSQL_PASS=

# ---- Redis ----
# 每個節點一個變數，名稱需以 REDIS_ADDR_ 開頭，並要在 tools.yaml 的 address 逐一列出。
# 單機只留 REDIS_ADDR_1；cluster 依節點數增減（兩邊要一致）。
REDIS_ADDR_1=127.0.0.1:6379
REDIS_ADDR_2=
REDIS_ADDR_3=
REDIS_ADDR_4=
REDIS_ADDR_5=
REDIS_ADDR_6=
REDIS_PASS=

# ---- MongoDB ----
# 最低版本需求 4.2，目前暫不支援

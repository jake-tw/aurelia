PORT=3000
NODE_ENV=local
API_PREFIX=api

# Security (optional)
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# AI (optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Worker Configuration
MAX_CONCURRENT_QUERY_JOBS=3

# Timing Configuration (in milliseconds)
MIN_TELEGRAM_EDIT_INTERVAL=6000
QUERY_JOB_TIMEOUT=300000
FIX_JOB_TIMEOUT=600000

# Logging
LOG_LEVEL=info

PORT=3000
NODE_ENV=local
API_PREFIX=api

# Security (optional)
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# AI (optional)
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_URL=

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Telegram Whitelist (comma-separated chat IDs, leave empty to allow all)
# Private chats: user IDs (e.g., 123456789,987654321)
# Group chats: group IDs, usually negative numbers (e.g., -1001234567890,-1009876543210)
# Group members: user IDs allowed to send messages in whitelisted groups (e.g., 123456789,987654321)
TELEGRAM_WHITELIST_PRIVATE=
TELEGRAM_WHITELIST_GROUP=
TELEGRAM_WHITELIST_GROUP_MEMBER=

# Worker Configuration
MAX_CONCURRENT_QUERY_JOBS=3

# Timing Configuration (in milliseconds)
MIN_TELEGRAM_EDIT_INTERVAL=6000
QUERY_JOB_TIMEOUT=300000
FIX_JOB_TIMEOUT=600000

# Logging
LOG_LEVEL=info
